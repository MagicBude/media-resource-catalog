# PostgreSQL development database
DATABASE_URL=postgresql://mrc:mrc@127.0.0.1:5432/mrc_dev

# Optional PostgreSQL integration-test database.
# Local tests skip DB integration tests when this is empty.
DATABASE_TEST_URL=

# API
API_HOST=127.0.0.1
API_PORT=4100

# Web
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4100

# TMDB application-level API Read Access Token.
# Required only for real TMDB imports. Fixture tests do not need it.
TMDB_ACCESS_TOKEN=
