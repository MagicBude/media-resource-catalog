{
  "name": "media-resource-catalog",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @media-resource-catalog/web --filter @media-resource-catalog/api dev",
    "build": "pnpm -r --filter @media-resource-catalog/core --filter @media-resource-catalog/database --filter @media-resource-catalog/api --filter @media-resource-catalog/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "repo:validate": "node scripts/validate-repository.mjs",
    "check": "pnpm repo:validate && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @media-resource-catalog/database db:generate",
    "db:migrate": "pnpm --filter @media-resource-catalog/database db:migrate",
    "db:studio": "pnpm --filter @media-resource-catalog/database db:studio"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.10.1",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.47.0",
    "vitest": "5.0.0"
  }
}
